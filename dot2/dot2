#!/usr/bin/env bash
# dot2 -- heap-free object sugar for gawk. Self-contained.
# Generated by build.sh -- do not edit by hand.
#
# Usage:
#   dot2 FILE.awk [DATA...]    run rewritten FILE.awk on DATA (or stdin)
#   dot2 a.awk b.awk DATA      multi-file run; .awk args go through prep
#   cat DATA | dot2 FILE.awk   stdin works too
#   dot2 -c FILE.awk           print rewritten source only
#   dot2 --demo NAME [DATA]    run demos/NAME/*.awk on DATA (or sample.*, or stdin)
#   dot2 --demos               list available demos under ./demos/
#   dot2 --show                dump bundled lib/*.awk (post-prep)
#   dot2 --help                this message

set -e

# ===== bundled sources (raw, pre-preprocessor) =====================

DOT_AWK=$(cat <<'__DOTAWK__'
# dot.awk -- heap-free object runtime + preprocessor (one file).
#
# As preprocessor:  gawk -v PREP=1 -f dot.awk SRC.awk > OUT.awk
# As runtime lib:   gawk -f dot.awk -f MYAPP.awk DATA
#
# Preprocessor rule: ".f" after a value-char becomes ["f"].
# So  it.foo        ->  it["foo"]
#     d.cols[i].is  ->  d["cols"][i]["is"]
# Heap-free: objects are arrays passed by reference; users write
# "it.foo", not ".it.foo".

# --- preprocessor pattern (fires only when -v PREP=1) --------------
# Note: uses match()/substr() loop to dodge a gawk 5.4.0 captures bug.
PREP == 1 {
  S = $0
  while (match(S, /([A-Za-z0-9_\]\)])\.([A-Za-z_][A-Za-z_0-9]*)/, M))
    S = substr(S,1,RSTART-1) M[1] "[\"" M[2] "\"]" substr(S,RSTART+RLENGTH)
  print S
  next }

# --- runtime: three functions --------------------------------------

# new(i, t): wipe i to empty array, tag i["is"]=t. First line of every
# constructor.
function new(i, t) { split("", i, ""); i["is"] = t }

# mk(i, t): polymorphic create. If t is a defined function, call it on i;
# else just new(i, t). Use for "give me a fresh Num/Sym/Data" by name.
function mk(i, t) {
  if (t in FUNCTAB) @t(i)
  else              new(i, t) }

# arr(x): force x to be an empty array.
function arr(x) { split("", x, "") }
__DOTAWK__
)

DOT_RUNTIME=$(cat <<'__RUNTIME__'
# === dot.awk ===
# dot.awk -- heap-free object runtime + preprocessor (one file).
#
# As preprocessor:  gawk -v PREP=1 -f dot.awk SRC.awk > OUT.awk
# As runtime lib:   gawk -f dot.awk -f MYAPP.awk DATA
#
# Preprocessor rule: ".f" after a value-char becomes ["f"].
# So  it.foo        ->  it["foo"]
#     d.cols[i].is  ->  d["cols"][i]["is"]
# Heap-free: objects are arrays passed by reference; users write
# "it.foo", not ".it.foo".

# --- preprocessor pattern (fires only when -v PREP=1) --------------
# Note: uses match()/substr() loop to dodge a gawk 5.4.0 captures bug.
PREP == 1 {
  S = $0
  while (match(S, /([A-Za-z0-9_\]\)])\.([A-Za-z_][A-Za-z_0-9]*)/, M))
    S = substr(S,1,RSTART-1) M[1] "[\"" M[2] "\"]" substr(S,RSTART+RLENGTH)
  print S
  next }

# --- runtime: three functions --------------------------------------

# new(i, t): wipe i to empty array, tag i["is"]=t. First line of every
# constructor.
function new(i, t) { split("", i, ""); i["is"] = t }

# mk(i, t): polymorphic create. If t is a defined function, call it on i;
# else just new(i, t). Use for "give me a fresh Num/Sym/Data" by name.
function mk(i, t) {
  if (t in FUNCTAB) @t(i)
  else              new(i, t) }

# arr(x): force x to be an empty array.
function arr(x) { split("", x, "") }

# === dotlib.awk ===
# dotlib.awk -- generic helpers (no object knowledge).
# rogues(): leak check.   o(x): polymorphic print.   _oo: workhorse.

# rogues(): warn on lowercase globals at end of run. Discipline check.
function rogues(    i) {
  for (i in SYMTAB) if (i ~ /^[a-z]/) print "leak:", i > "/dev/stderr" }

# o(x): print one thing.
#   array, 1 in x   -> "[..]" list,  numeric-sorted, no key prefix
#   array, no 1     -> "{..}" dict,  string-sorted,  "k: " prefix
#   number-shaped   -> %d if whole, else %G
#   else            -> %s
function o(x) {
  if (isarray(x)) {
    if (1 in x) _oo(x, "[", "]", "@ind_num_asc", 0)
    else        _oo(x, "{", "}", "@ind_str_asc", 1)
  } else if (x ~ /^-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?$/) {
    if (x == int(x)) printf "%d", x
    else             printf "%G", x }
  else printf "%s", x }

function _oo(a, lhs, rhs, how, withkey,    n, i, k, sep, sorted) {
  printf "%s", lhs
  n = asorti(a, sorted, how)
  sep = ""
  for (i = 1; i <= n; i++) {
    k = sorted[i]
    printf "%s", sep
    if (withkey) printf "%s: ", k
    o(a[k])
    sep = ", " }
  printf "%s", rhs }

__RUNTIME__
)

die()   { echo "dot2: $*" >&2; exit 1; }
usage() { awk '/^# Usage:/{p=1} p&&!/^#/{exit} p{sub(/^# ?/,""); print}' "$0"; }

setup_tmp() {
  TMPD=$(mktemp -d "${TMPDIR:-/tmp}/dot2.XXXXXX")
  trap 'rm -rf "$TMPD"' EXIT
}

# preprocess via dot.awk with -v PREP=1.
prep_str()  { printf '%s\n' "$2" | gawk -v PREP=1 -e "$DOT_AWK" > "$TMPD/$1"; echo "$TMPD/$1"; }
prep_file() { local b=$(basename "$1"); gawk -v PREP=1 -e "$DOT_AWK" "$1" > "$TMPD/$b"; echo "$TMPD/$b"; }

build_gawk_args() {
  GAWK_ARGS=( -f "$(prep_str _runtime.awk "$DOT_RUNTIME")" )
  for f; do GAWK_ARGS+=( -f "$(prep_file "$f")" ); done
}

list_demos() {
  [ -d demos ] || die "no ./demos/ directory in $(pwd)"
  for d in demos/*/; do
    name=$(basename "$d")
    first=$(ls "$d"*.awk 2>/dev/null | head -1)
    desc=""
    [ -n "$first" ] && desc=$(awk 'NR==1 && /^#/ {sub(/^# ?/,""); print; exit}' "$first")
    printf "  %-20s %s\n" "$name" "$desc"
  done
}

run_demo() {
  local name=$1; shift
  local dir="demos/$name"
  [ -d "$dir" ] || die "--demo: no such demo: $dir"

  local sources=( "$dir"/*.awk )
  [ -e "${sources[0]}" ] || die "--demo: no .awk files in $dir"

  local data=( "$@" )
  if [ ${#data[@]} -eq 0 ]; then
    local samples=( "$dir"/sample.* )
    [ -e "${samples[0]}" ] && data=( "${samples[0]}" )
  elif [ "${data[0]}" = "-" ]; then
    data=()
  fi

  setup_tmp
  build_gawk_args "${sources[@]}"
  exec gawk "${GAWK_ARGS[@]}" "${data[@]}"
}

run_files() {
  local sources=() data=()
  for a; do
    case "$a" in
      *.awk) sources+=( "$a" ) ;;
      *)     data+=( "$a" ) ;;
    esac
  done
  setup_tmp
  build_gawk_args "${sources[@]}"
  exec gawk "${GAWK_ARGS[@]}" "${data[@]}"
}

case "${1:-}" in
  ""|-h|--help) usage; exit 0 ;;
  -c)           shift; [ $# -gt 0 ] || die "-c: need FILE.awk"
                exec gawk -v PREP=1 -e "$DOT_AWK" "$@" ;;
  --show)       setup_tmp; cat "$(prep_str _runtime.awk "$DOT_RUNTIME")"; exit 0 ;;
  --demos)      list_demos; exit 0 ;;
  --demo)       shift; [ $# -gt 0 ] || die "--demo: need NAME (try: --demos)"
                run_demo "$@" ;;
  *)            run_files "$@" ;;
esac
